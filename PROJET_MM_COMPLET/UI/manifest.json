{
  "_version": "1.1.0",
  "sap.app": {
    "id": "purch.req.manage",
    "type": "application",
    "title": "Gestion des Demandes d'Achat",
    "description": "Application de gestion des flux MM",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/Z_I_PURCHREQ_CDS/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.84.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.f": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "models": {
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "purch.req.manage.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "defaultOperationMode": "Server",
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Request"
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [],
      "targets": {}
    }
  }
}
