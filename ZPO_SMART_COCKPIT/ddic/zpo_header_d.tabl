@EndUserText.label: 'Draft table for ZI_PO_HEADER'
@AbapCatalog.enhancementCategory: #EXTENSIBLE_ANY
@AbapCatalog.tableCategory: #TRANSPARENT
@AbapCatalog.deliveryClass: #A
@AbapCatalog.dataMaintenance: #RESTRICTED
define table zpo_header_d {
  key mandt         : mandt not null;
  key purchaseorder : ebeln not null;
  companycode       : bukrs;
  supplier          : lifnr;
  purchaseordertype : bsart;
  purchaseorderdate : bedat;
  currency          : waers;
  @Semantics.amount.currencyCode: 'zpo_header_d.currency'
  netamount         : netwr;
  createdbyuser     : ernam;
  creationdate      : erdat;
  lastchangedate    : aedat;
  deletionindicator : loekz;
  "%admin"          : include sych_bdl_draft_admin_inc;
}
