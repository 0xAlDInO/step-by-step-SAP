unmanaged implementation in class ZBP_I_PO unique;
strict ( 2 );
with draft;

define behavior for ZI_PO_HEADER_RAL alias PurchaseOrder
draft table zpo_header_d
lock master
total etag CreationDate
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly ) PurchaseOrder;
  field ( mandatory ) CompanyCode, Supplier, PurchaseOrderType;

  association _Items { create; with draft; }

  mapping for ekko
  {
    PurchaseOrder = ebeln;
    CompanyCode = bukrs;
    Supplier = lifnr;
    PurchaseOrderType = bsart;
    PurchasingOrganization = ekorg;
    PurchasingGroup = ekgrp;
    PurchaseOrderDate = bedat;
    Currency = waers;
    CreationDate = aedat;
    DeletionIndicator = loekz;
  }
}

define behavior for ZI_PO_ITEM_RAL alias PurchaseOrderItem
draft table zpo_item_d
lock dependency by _Header
authorization dependent by _Header
{
  update;
  delete;

  field ( readonly ) PurchaseOrder, PurchaseOrderItem;
  field ( mandatory ) Material, Plant, PurchaseOrderQuantity;

  association _Header { with draft; }

  mapping for ekpo
  {
    PurchaseOrder = ebeln;
    PurchaseOrderItem = ebelp;
    Material = matnr;
    Plant = werks;
    PurchaseOrderQuantity = menge;
    PurchaseOrderQuantityUnit = meins;
    NetPrice = netpr;
    PurchaseOrderItemText = txz01;
    DeletionIndicator = loekz;
  }
}
