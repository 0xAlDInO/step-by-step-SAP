projection;
strict ( 2 );
use draft;

define behavior for ZC_PO_LIST_RAL alias PurchaseOrder
{
  use create;
  use update;
  use delete;

  use association Items { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZC_PO_DETAIL_RAL alias PurchaseOrderItem
{
  use update;
  use delete;

  use association _Header { with draft; }
}
