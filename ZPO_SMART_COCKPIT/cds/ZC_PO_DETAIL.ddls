@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Purchase Order Item Detail'
@UI.headerInfo: { typeName: 'Purchase Order Item', typeNamePlural: 'Purchase Order Items', title: { type: #STANDARD, value: 'PurchaseOrderItem' } }

define view entity ZC_PO_DETAIL
  as projection on ZI_PO_ITEM
{
      @UI.facet: [
        { id: 'ItemGeneralInfo', type: #IDENTIFICATION_REFERENCE, label: 'Item Information', position: 10 }
      ]

      @UI.lineItem: [ { position: 10 } ]
      @UI.identification: [ { position: 10 } ]
  key PurchaseOrder,

      @UI.lineItem: [ { position: 20 } ]
      @UI.identification: [ { position: 20 } ]
  key PurchaseOrderItem,

      @UI.lineItem: [ { position: 30 } ]
      @UI.identification: [ { position: 30 } ]
      Material,

      @UI.lineItem: [ { position: 40 } ]
      @UI.identification: [ { position: 40 } ]
      Plant,

      @UI.lineItem: [ { position: 50 } ]
      @UI.identification: [ { position: 50 } ]
      PurchaseOrderQuantity,

      @UI.lineItem: [ { position: 60 } ]
      @UI.identification: [ { position: 60 } ]
      PurchaseOrderQuantityUnit,

      @UI.lineItem: [ { position: 70 } ]
      @UI.identification: [ { position: 70 } ]
      NetPrice,

      @UI.lineItem: [ { position: 80 } ]
      @UI.identification: [ { position: 80 } ]
      PurchaseOrderItemText,

      /* Associations */
      _Header : redirected to parent ZC_PO_LIST
}
