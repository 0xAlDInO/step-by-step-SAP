@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Interface View Purchase Order Header RAL'

define root view entity ZI_PO_HEADER_RAL
  as select from ekko
  composition [0..*] of ZI_PO_ITEM_RAL as _Items
{
  key ebeln as PurchaseOrder,
      bukrs as CompanyCode,
      lifnr as Supplier,
      bsart as PurchaseOrderTypeCode,
      ekorg as PurchasingOrganization,
      ekgrp as PurchasingGroup,
      bedat as PurchaseOrderDate,
      waers as Currency,
      ernam as CreatedByUser,
      aedat as CreationDate,
      loekz as DeletionIndicator,

      _Items
}
