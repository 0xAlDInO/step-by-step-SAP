@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Interface View Purchase Order Header'

define root view entity ZI_PO_HEADER
  as select from ekko
  composition [0..*] of ZI_PO_ITEM as _Items
{
  key ebeln as PurchaseOrder,
      bukrs as CompanyCode,
      lifnr as Supplier,
      bsart as PurchaseOrderType,
      ekorg as PurchasingOrganization,
      ekgrp as PurchasingGroup,
      bedat as PurchaseOrderDate,
      waers as Currency,
      @Semantics.amount.currencyCode: 'Currency'
      netwr as NetAmount,
      ernam as CreatedByUser,
      erdat as CreationDate,
      aedat as LastChangeDate,
      loekz as DeletionIndicator,

      _Items
}
