@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Purchase Order Detail RAL'

define view entity ZC_PO_DETAIL_RAL
  as projection on ZI_PO_ITEM_RAL
{
      @UI.facet: [ { id: 'ItemInfo', type: #IDENTIFICATION_REFERENCE, label: 'Item Information', position: 10 } ]

      @UI.lineItem: [ { position: 10 } ]
  key PurchaseOrder,

      @UI.lineItem: [ { position: 20 } ]
  key PurchaseOrderItem,

      @UI.lineItem: [ { position: 30 } ]
      Material,

      @UI.lineItem: [ { position: 40 } ]
      Plant,

      @UI.lineItem: [ { position: 50 } ]
      PurchaseOrderQuantity,

      @UI.lineItem: [ { position: 60 } ]
      PurchaseOrderQuantityUnit,

      @UI.lineItem: [ { position: 70 } ]
      NetPrice,

      Currency,

      @UI.lineItem: [ { position: 80 } ]
      PurchaseOrderItemText,

      _Header : redirected to parent ZC_PO_LIST_RAL
}
